# MongoDB Connection URIs (MongoDB Atlas)
# User Database - for authentication and user data
MONGODB_USER_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/notesapp_users?retryWrites=true&w=majority&appName=YourApp

# Notes Database - for notes and related data
MONGODB_NOTES_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/notesapp_notes?retryWrites=true&w=majority&appName=YourApp

# Server Port
PORT=5000
